map update_media_metadata(int mediaId, string altText, string caption)
{
	result = Map();
	result.put("ok",false);

	actor = Demo_Employees[Work_Email == zoho.loginuserid && Status == "Active"];
	if(actor.count() == 0)
	{
		actor = Demo_Employees[Creator_Username == zoho.loginuser && Status == "Active"];
	}
	if(actor.count() == 0)
	{
		result.put("message","Your Creator login is not mapped to an active editorial employee.");
		return result;
	}

	media = Media_Assets[ID == mediaId];
	if(media.count() == 0)
	{
		result.put("message","Image not found.");
		return result;
	}
	adminRole = Editorial_Role_Assignments[Employee == actor.ID && Editorial_Role == "Editorial Admin" && Active == true];
	authorRole = Editorial_Role_Assignments[Employee == actor.ID && Editorial_Role == "Author" && Active == true];
	actorIsUploader = media.Uploaded_By != null && media.Uploaded_By.ID == actor.ID;
	if(!actorIsUploader && adminRole.count() == 0 && authorRole.count() == 0)
	{
		result.put("message","Only the image uploader, an Author, or an Editorial Admin can update image details.");
		return result;
	}
	if(media.Status == "Archived" || media.Status == "Failed")
	{
		result.put("message","Archived or failed images cannot be edited.");
		return result;
	}

	cleanAltText = ifnull(altText,"").trim();
	cleanCaption = ifnull(caption,"").trim();
	if(cleanAltText.length() < 1 || cleanAltText.length() > 250)
	{
		result.put("message","Alt text must contain between 1 and 250 characters.");
		return result;
	}
	if(cleanCaption.length() > 500)
	{
		result.put("message","Caption must contain 500 characters or fewer.");
		return result;
	}

	media.Alt_Text = cleanAltText;
	media.Caption = cleanCaption;

	metadata = Map();
	metadata.put("mediaId",media.ID);
	metadata.put("captionPresent",cleanCaption != "");
	insert into Audit_Events
	[
		Event_UUID = "EVT-MEDIA-METADATA-" + media.ID + "-" + zoho.currenttime.toLong()
		Entity_Type = "Media"
		Entity_UUID = media.Media_UUID
		Event_Type = "Media Metadata Updated"
		Actor_Employee = actor.ID
		Previous_State = media.Status
		New_State = media.Status
		Event_Summary = actor.Display_Name + " updated image alt text and caption."
		Event_Metadata = metadata.toString()
		Occurred_At = zoho.currenttime
	];

	result.put("ok",true);
	result.put("message","Image details saved.");
	result.put("mediaId",media.ID.toString());
	result.put("altText",cleanAltText);
	result.put("caption",cleanCaption);
	return result;
}
