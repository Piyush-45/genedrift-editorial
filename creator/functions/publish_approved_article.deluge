map publish_approved_article(int articleId)
{
	result = Map();
	result.put("ok",false);

	actor = Demo_Employees[Work_Email == zoho.loginuserid && Status == "Active"];
	if(actor.count() == 0)
	{
		actor = Demo_Employees[Creator_Username == zoho.loginuser && Status == "Active"];
	}
	if(actor.count() == 0)
	{
		result.put("message","Your Creator login is not mapped to an active editorial employee.");
		return result;
	}
	publisherRole = Editorial_Role_Assignments[Employee == actor.ID && Active == true && (Editorial_Role == "Publisher" || Editorial_Role == "Editorial Admin")];
	if(publisherRole.count() == 0)
	{
		result.put("message","Only an active publisher or editorial admin can publish approved content.");
		return result;
	}

	article = Articles[ID == articleId];
	if(article.count() == 0)
	{
		result.put("message","Article not found.");
		return result;
	}
	approvedRevisionId = ifnull(article.Approved_Revision_ID,"").trim();
	if(article.Workflow_State == "Published" && ifnull(article.Published_Revision_ID,"").trim() != "")
	{
		existingJob = Publication_Jobs[Article == article.ID && Revision == article.Published_Revision_ID.toLong() && Status == "Succeeded"];
		result.put("ok",true);
		result.put("message","Article is already published.");
		result.put("articleId",article.ID);
		result.put("jobId",if(existingJob.count() > 0,existingJob.ID,""));
		result.put("articleState",article.Workflow_State);
		return result;
	}
	if(article.Workflow_State != "Approved" || approvedRevisionId == "")
	{
		result.put("message","Only an article with an approved revision pointer can be published.");
		return result;
	}
	revision = Article_Revisions[ID == approvedRevisionId.toLong()];
	if(revision.count() == 0 || revision.Revision_State != "Approved")
	{
		result.put("message","The approved revision is not ready to publish.");
		return result;
	}

	existingOpenJob = Publication_Jobs[Article == article.ID && Revision == revision.ID && (Action == "Publish" || Action == "Schedule") && (Status == "Queued" || Status == "Processing")];
	if(existingOpenJob.count() > 0)
	{
		if(existingOpenJob.Status == "Queued")
		{
			return thisapp.handoff_publication_to_catalyst(existingOpenJob.ID);
		}
		result.put("ok",true);
		result.put("message","Catalyst is already processing this approved revision.");
		result.put("articleId",article.ID);
		result.put("revisionId",revision.ID);
		result.put("jobId",existingOpenJob.ID);
		return result;
	}

	idempotencyKey = "PUB-" + article.Article_UUID + "-" + revision.Revision_UUID;
	jobId = insert into Publication_Jobs
	[
		Idempotency_Key = idempotencyKey
		Article = article.ID
		Revision = revision.ID
		Action = "Publish"
		Status = "Queued"
		Attempt_Count = 0
		Requested_By = actor.ID
		Requested_At = zoho.currenttime
	];

	metadata = Map();
	metadata.put("jobId",jobId);
	metadata.put("revisionId",revision.ID);
	metadata.put("revisionNumber",revision.Revision_Number);
	metadata.put("idempotencyKey",idempotencyKey);
	insert into Audit_Events
	[
		Event_UUID = "EVT-PUBLISH-QUEUED-" + jobId
		Entity_Type = "Publication"
		Entity_UUID = article.Article_UUID
		Event_Type = "Publication Queued"
		Actor_Employee = actor.ID
		Previous_State = article.Workflow_State
		New_State = article.Workflow_State
		Event_Summary = actor.Display_Name + " queued revision " + revision.Revision_Number + " for Catalyst publication."
		Event_Metadata = metadata.toString()
		Occurred_At = zoho.currenttime
	];

	return thisapp.handoff_publication_to_catalyst(jobId);
}
